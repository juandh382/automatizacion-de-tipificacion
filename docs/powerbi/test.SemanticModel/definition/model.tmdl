model Model
	culture: es-VE
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-VE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Tabla Datos","Tabla Productos"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Tabla Datos'
ref table 'Tabla Productos'

ref cultureInfo es-VE

